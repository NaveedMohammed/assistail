<Window x:Class="Assistail.Extras.ExtrasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistail extras" Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assistail.ico" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary Source="/Assistail;component/Theme.xaml"/>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="#262624" BorderBrush="#3D3C38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title (drag to move) -->
            <DockPanel x:Name="TitleBar" Grid.Row="0" Margin="22,16,14,4" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Flat}" Click="Cancel_Click" ToolTip="Close without saving" Padding="0"/>
                <Image Source="pack://application:,,,/assistail.ico" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="Extras" Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="17" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,8,22,4">
                <RadioButton x:Name="TabInstalled" Content="Installed" GroupName="tabs" Style="{StaticResource Seg}" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAvailable" Content="Available" GroupName="tabs" Style="{StaticResource Seg}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabUpdates" Content="Updates" GroupName="tabs" Style="{StaticResource Seg}" Checked="Tab_Checked"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="620" Margin="0,0,6,0">
                <StackPanel Margin="22,0,16,8">
                    <!-- ===================== installed -->
                    <StackPanel x:Name="InstalledPanel">
                        <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,8,0,12"
                                   Text="Extras are optional packs: reminders, timers and routines for your buddy. They only contain settings and lines; they can't run programs."/>
                        <StackPanel x:Name="PackList"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed"
                                   Text="No extras installed yet. Have a look in “Available”, or drop a pack (.zip) on your buddy."/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Install from file…" Style="{StaticResource Flat}" Click="Install_Click"/>
                            <Button Content="Open extras folder" Style="{StaticResource Flat}" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===================== available / updates (filled from the catalog) -->
                    <StackPanel x:Name="StorePanel" Visibility="Collapsed">
                        <TextBlock x:Name="StoreStatus" Style="{StaticResource Hint}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
                        <StackPanel x:Name="StoreList"/>
                        <Button x:Name="UpdateAllButton" Content="Update all" Style="{StaticResource Primary}" HorizontalAlignment="Left"
                                Margin="0,4,0,8" Click="UpdateAll_Click" Visibility="Collapsed"/>
                        <CheckBox x:Name="OnlineBox" Content="Check for new and updated extras online" Margin="0,8,0,0" Click="Online_Click"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                                   Text="Downloads the list of packs from GitHub (and once a day looks for pack updates). Nothing about you or your PC is sent."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource Flat}" Click="Refresh_Click"/>
                            <Button Content="Open the catalog on GitHub" Style="{StaticResource Flat}" Margin="8,0,0,0" Click="OpenCatalog_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="22,10,22,18">
                <TextBlock x:Name="Status" Foreground="#F28B82" FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"/>
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Flat}" Click="Cancel_Click"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
