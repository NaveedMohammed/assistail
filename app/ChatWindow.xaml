<Window x:Class="Assistail.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistail" Width="580" Height="540" MinWidth="380" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False"
        Icon="pack://application:,,,/assistail.ico"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#EDEBE6"/>
        <SolidColorBrush x:Key="Muted" Color="#9B978F"/>
        <SolidColorBrush x:Key="Accent" Color="#D97757"/>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C9C6BF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="9,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3936"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="8" Width="34" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E58A6C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="14" Background="#262624" BorderBrush="#3D3C38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid x:Name="Header" Grid.Row="0" Margin="14,10,10,6" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/assistail.ico" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderName" Grid.Column="1" Text="Claude" Foreground="{StaticResource Fg}" FontWeight="SemiBold"
                           Margin="8,0,10,0" VerticalAlignment="Center"/>
                <Border x:Name="FolderChip" Grid.Column="2" HorizontalAlignment="Left" Background="#33322F"
                        CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="FolderText" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="OpenCodeButton" Style="{StaticResource HeaderButton}" Content="&gt;_  Claude Code"
                            ToolTip="Open Claude Code in this folder" Click="OpenCode_Click"/>
                    <Button Style="{StaticResource HeaderButton}" Content="New chat" ToolTip="Start a new conversation" Click="NewChat_Click"/>
                    <Button Style="{StaticResource HeaderButton}" Content="✕" ToolTip="Hide (Esc)" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Conversation -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                <StackPanel x:Name="Messages" Margin="18,4,14,8">
                    <TextBlock x:Name="EmptyHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,30,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Hi! Ask me anything.&#x0a;Enter to send · Shift+Enter for a new line · Esc to hide"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="2" Margin="12,4,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Grid.Row="0" Foreground="{StaticResource Muted}" FontStyle="Italic"
                           FontSize="12.5" Margin="6,0,0,6" Visibility="Collapsed" Text="Thinking…"/>
                <Border Grid.Row="1" Background="#30302E" CornerRadius="10" BorderBrush="#45443F" BorderThickness="1" Padding="10,6,6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                                 CaretBrush="{StaticResource Fg}" PreviewKeyDown="Input_PreviewKeyDown"
                                 TextChanged="Input_TextChanged"/>
                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Foreground="#77736C" Margin="3,0,0,0"
                                   VerticalAlignment="Center" Text="Ask Claude…"/>
                        <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource SendButton}" Margin="8,0,0,0"
                                VerticalAlignment="Bottom" Content="↑" FontSize="16" FontWeight="Bold"
                                ToolTip="Send (Enter)" Click="Send_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
