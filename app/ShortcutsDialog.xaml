<Window x:Class="Assistail.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assistail.ico" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="#33322F"/>
            <Setter Property="Foreground" Value="#C9C6BF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="KeyBox" TargetType="TextBox">
            <Setter Property="Background" Value="#30302E"/>
            <Setter Property="Foreground" Value="#EDEBE6"/>
            <Setter Property="BorderBrush" Value="#45443F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Segoe UI"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#D97757"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Margin="12" CornerRadius="14" Background="#262624" BorderBrush="#3D3C38" BorderThickness="1" Padding="20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Keyboard shortcuts" Foreground="#EDEBE6" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Text="Click a box, then press the keys you want (e.g. Ctrl+Alt+T). Use at least one of Ctrl, Alt, Shift or Win."
                       Foreground="#9B978F" FontSize="12.5" Margin="0,4,0,14" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ChatLabel" Text="Open chat" Foreground="#EDEBE6"/>
                    <TextBlock Text="Shows or hides the chat" Foreground="#77736C" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBox x:Name="ChatBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyBox}" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Off" Margin="6,0,0,0" Style="{StaticResource Flat}" Tag="chat" Click="Off_Click" ToolTip="Turn this shortcut off"/>

                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TrickLabel" Text="Next trick" Foreground="#EDEBE6"/>
                    <TextBlock Text="Each press does the next trick" Foreground="#77736C" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0"/>
                </StackPanel>
                <TextBox x:Name="TrickBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyBox}" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Off" Margin="6,0,0,0" Style="{StaticResource Flat}" Tag="trick" Click="Off_Click" ToolTip="Turn this shortcut off"/>
            </Grid>

            <TextBlock x:Name="Status" Foreground="#F28B82" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Reset to defaults" Style="{StaticResource Flat}" Click="Reset_Click"/>
                <Button DockPanel.Dock="Right" Content="Save" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"
                        Background="#D97757" Foreground="White" BorderThickness="0" Padding="16,5" Cursor="Hand"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Flat}" Click="Cancel_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
