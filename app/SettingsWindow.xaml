<Window x:Class="Assistail.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistail settings" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assistail.ico" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="#262624" BorderBrush="#3D3C38" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title (drag to move) -->
            <DockPanel x:Name="TitleBar" Grid.Row="0" Margin="22,16,14,4" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Flat}" Click="Cancel_Click" ToolTip="Close without saving" Padding="0"/>
                <Image Source="pack://application:,,,/assistail.ico" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="Settings" Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="17" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,3,0,0" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="620" Margin="0,0,6,0">
                <StackPanel Margin="22,0,16,8">

                    <!-- ===================== buddy -->
                    <TextBlock Text="YOUR BUDDY" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource Label}"/>
                        <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource Box}" MaxLength="24" Width="220" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource Label}"/>
                        <StackPanel x:Name="SizePanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal"/>
                        <TextBlock Grid.Row="4" Text="Quirks when idle" Style="{StaticResource Label}"/>
                        <StackPanel x:Name="QuirksPanel" Grid.Row="4" Grid.Column="1" Orientation="Horizontal"/>
                    </Grid>
                    <CheckBox x:Name="SelfTalkBox" Content="Says things on his own now and then" Margin="150,10,0,0"/>

                    <!-- ===================== chat -->
                    <TextBlock Text="CHAT" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource Label}"/>
                        <StackPanel x:Name="ModelPanel" Grid.Column="1" Orientation="Horizontal"/>
                    </Grid>
                    <CheckBox x:Name="ReadsFolderBox" Margin="150,10,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Can read files in the chat's 📁 folder (never changes them)"/>
                    </CheckBox>

                    <!-- ===================== shortcuts -->
                    <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource Section}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Click a box, then press the keys you want. Use at least one of Ctrl, Alt, Shift or Win."/>
                    <Grid x:Name="ShortcutGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <Button Content="Reset shortcuts to defaults" Style="{StaticResource Flat}" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="ResetShortcuts_Click"/>

                    <!-- ===================== alerts -->
                    <TextBlock Text="CLAUDE CODE ALERTS" Style="{StaticResource Section}"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Foreground="{StaticResource Muted}"
                               Text="Your buddy tells you when a Claude Code session finishes or needs your permission. Click him (or the bubble) to jump to that terminal. This adds two small hooks to Claude Code's settings.json."/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="RemoveHooksButton" DockPanel.Dock="Right" Content="Remove" Style="{StaticResource Flat}" Margin="6,0,0,0" Click="RemoveHooks_Click"/>
                        <Button x:Name="InstallHooksButton" DockPanel.Dock="Right" Content="Set up…" Style="{StaticResource Flat}" Click="InstallHooks_Click"/>
                        <TextBlock x:Name="HooksStatus" Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap"/>
                    </DockPanel>
                    <CheckBox x:Name="AlertsBox" Content="Show alerts"/>

                    <!-- ===================== updates -->
                    <TextBlock Text="UPDATES" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="AutoUpdateBox" Margin="0" Content="Check for updates once a day"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                               Text="Asks GitHub for the latest release. Nothing about you or your PC is sent. You're always asked before anything installs."/>
                    <CheckBox x:Name="ExtrasOnlineBox" Margin="0,10,0,0" Content="Check for new and updated extras"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                               Text="Gets the list of extras packs from GitHub when you open Extras, and once a day looks for updates to the ones you have."/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="CheckNowButton" DockPanel.Dock="Left" Content="Check now" Style="{StaticResource Flat}" Click="CheckNow_Click"/>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Label}" FontSize="13" Margin="10,0,0,0" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- ===================== general -->
                    <TextBlock Text="GENERAL" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="StartupBox" Margin="0" Content="Start Assistail when I sign in to Windows"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="22,10,22,18">
                <TextBlock x:Name="Status" Foreground="#F28B82" FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"/>
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Flat}" Click="Cancel_Click"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
